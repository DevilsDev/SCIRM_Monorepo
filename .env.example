# SCIRM Environment Configuration

# =============================================================================
# Security Configuration
# =============================================================================
JWT_SECRET_KEY=CHANGE-ME-TO-A-SECURE-RANDOM-STRING
JWT_EXPIRATION_HOURS=24
ENVIRONMENT=development                 # development, staging, production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
MFA_ENABLED=false                       # Set to true to require TOTP MFA
SERVICE_API_KEY=scirm-internal-dev-key  # For service-to-service auth in production

# OAuth 2.0 Providers
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_AZURE_CLIENT_ID=
OAUTH_AZURE_CLIENT_SECRET=
OAUTH_AZURE_TENANT_ID=common

# Email (SMTP)
SMTP_HOST=                              # e.g., smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=                         # Comma-separated recipient emails
ALERT_EMAIL_FROM=alerts@scirm.io

# Alerting Integrations
PAGERDUTY_ROUTING_KEY=                  # PagerDuty Events API v2 routing key
SLACK_WEBHOOK_URL=                      # Slack incoming webhook URL
ALERT_WEBHOOK_URL=                      # Generic webhook for alerts

# ERP Connectors
SAP_BASE_URL=                           # SAP S/4HANA OData endpoint
SAP_CLIENT=100
SAP_USERNAME=
SAP_PASSWORD=
ORACLE_ERP_BASE_URL=                    # Oracle Fusion Cloud REST endpoint
ORACLE_ERP_USERNAME=
ORACLE_ERP_PASSWORD=
DYNAMICS_BASE_URL=                      # Dynamics 365 Dataverse URL
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=

# Auto-Refresh
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_INTERVAL_MINUTES=15

# OpenTelemetry Tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=scirm

# =============================================================================
# AI/LLM Configuration
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# LLM Configuration
LLM_PROVIDER=openai                    # openai or anthropic
LLM_MODEL=gpt-4-turbo-preview          # or claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.3                    # Lower = more consistent
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_ATTEMPTS=2

# =============================================================================
# Vector Database Configuration
# =============================================================================
# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=scirm-embeddings

# Weaviate (Alternative)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key-here

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://scirm:password@localhost:5432/scirm
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# External Data Sources
# =============================================================================
# Weather APIs
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHERAPI_KEY=your-weatherapi-key

# Logistics APIs
FEDEX_API_KEY=your-fedex-api-key
UPS_API_KEY=your-ups-api-key
DHL_API_KEY=your-dhl-api-key

# Economic/Financial APIs
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FRED_API_KEY=your-fred-api-key

# Regulatory APIs
FDA_API_KEY=your-fda-api-key
EMA_API_KEY=your-ema-api-key

# =============================================================================
# Security Configuration
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

OAUTH2_CLIENT_ID=your-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret

# =============================================================================
# Service Configuration
# =============================================================================
API_GATEWAY_PORT=8000
COORDINATOR_SERVICE_PORT=8001
PLANNER_SERVICE_PORT=8002
RESEARCHER_SERVICE_PORT=8003
EXECUTOR_SERVICE_PORT=8004
REVIEWER_SERVICE_PORT=8005

# Service URLs (for inter-service communication)
COORDINATOR_SERVICE_URL=http://localhost:8001
PLANNER_SERVICE_URL=http://localhost:8002
RESEARCHER_SERVICE_URL=http://localhost:8003
EXECUTOR_SERVICE_URL=http://localhost:8004
REVIEWER_SERVICE_URL=http://localhost:8005

# =============================================================================
# Monitoring & Observability
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_PORT=16686

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Development Configuration
# =============================================================================
ENVIRONMENT=development
DEBUG=true
RELOAD=true

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WEBSOCKET_URL=ws://localhost:8000/ws

# =============================================================================
# Production Configuration (Override in production)
# =============================================================================
# ENVIRONMENT=production
# DEBUG=false
# RELOAD=false
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem

# =============================================================================
# Compliance & Audit
# =============================================================================
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for compliance
DATA_CLASSIFICATION_LEVEL=confidential
GDPR_COMPLIANCE_MODE=true
HIPAA_COMPLIANCE_MODE=true
