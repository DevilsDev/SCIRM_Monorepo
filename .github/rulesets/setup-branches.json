{
  "name": "Setup Branches - Infrastructure Protection",
  "target": "branch",
  "source_type": "Repository",
  "source": "DevilsDev/SCIRM_Monorepo",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/firebase-setup", "refs/heads/netlify-setup"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_approving_review_count": 1,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_signatures",
      "parameters": {}
    },
    {
      "type": "creation",
      "parameters": {}
    },
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    },
    {
      "type": "deletion",
      "parameters": {}
    }
  ],
  "bypass_actors": []
}
