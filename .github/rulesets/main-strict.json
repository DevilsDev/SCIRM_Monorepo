{
  "name": "Main Branch Protection - Strict",
  "target": "branch",
  "source_type": "Repository",
  "source": "DevilsDev/SCIRM_Monorepo",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_approving_review_count": 2,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {
            "context": "docs-build",
            "integration_id": null
          },
          {
            "context": "lint",
            "integration_id": null
          },
          {
            "context": "tests",
            "integration_id": null
          },
          {
            "context": "security-scans",
            "integration_id": null
          },
          {
            "context": "codeql-analysis",
            "integration_id": null
          },
          {
            "context": "no-internal-dashboards-to-main",
            "integration_id": null
          },
          {
            "context": "no-deploy-from-main",
            "integration_id": null
          }
        ],
        "strict_required_status_checks_policy": true
      }
    },
    {
      "type": "non_fast_forward",
      "parameters": {}
    },
    {
      "type": "required_signatures",
      "parameters": {}
    },
    {
      "type": "creation",
      "parameters": {}
    },
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    },
    {
      "type": "deletion",
      "parameters": {}
    },
    {
      "type": "required_linear_history",
      "parameters": {}
    }
  ],
  "bypass_actors": []
}
